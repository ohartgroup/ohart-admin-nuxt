    "@nuxtjs/i18n": "10.5.0",
    "@nuxtjs/seo": "5.3.6",
    "@nuxtjs/stylelint-module": "^5.2.1",
    "@nuxtjs/supabase": "2.0.9",
    "@pinia/nuxt": "1.0.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vueuse/nuxt": "14.3.0",
