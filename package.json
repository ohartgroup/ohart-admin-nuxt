  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3041",
    "preview": "nuxt preview --port 3041",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "stylelint": "stylelint \"**/*.{vue,css,scss}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup": "nuxt cleanup",
    "analyze": "npx nuxt analyze",
    "typecheck": "nuxt typecheck",
    "delete:modules": "rm -rf node_modules .nuxt",
    "upgrade:force": "nuxt upgrade --force",
    "upgrade:dedupe": "npx nuxt upgrade --dedupe",
    "version:major": "node scripts/version-manager.js major",
    "version:minor": "node scripts/version-manager.js minor",
    "version:patch": "node scripts/version-manager.js patch",
    "version:clear": "node scripts/version-manager.js clear",
    "supabase:login": "supabase login",
    "supabase:type": "supabase gen types typescript --project-id fgpmbbuodmypvuifafhi --schema public,admin > app/types/database.types.ts"
  },
